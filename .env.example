# Copy to `.env.local` for local development, and set the same values in your
# Vercel project settings for preview/production.
#
# NEVER commit real credentials. `.env*.local` is git-ignored.

# Absolute base URL of the deployed site. Used for canonical URLs, Open Graph
# tags, sitemap.xml and robots.txt.
#
# On Vercel this is OPTIONAL: if it is unset, the site falls back to
# VERCEL_PROJECT_PRODUCTION_URL, which Vercel provides automatically and points
# at the project's production domain. Set it explicitly once a custom domain is
# live, or to override the domain for any reason. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.inojashydraulic.com

# ---------------------------------------------------------------------------
# Contact form delivery (optional — the form is intentionally inert until set)
# ---------------------------------------------------------------------------
# The /api/contact route forwards validated submissions to this webhook as JSON.
# Point it at your CRM, an email provider (Resend, Postmark, SendGrid), a Zapier
# / Make hook, or replace the fetch in app/api/contact/route.ts entirely.
# While this is unset the API responds 503 and the UI tells the visitor to use
# the phone/email details instead — it never claims a message was delivered.
CONTACT_WEBHOOK_URL=

# Optional shared secret sent as the `Authorization: Bearer <token>` header
# on the webhook request above.
CONTACT_WEBHOOK_TOKEN=
